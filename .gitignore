# Environment files (never commit secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Local SQLite database files
storage/database/*.db
storage/database/*.db-journal
storage/database/*.db-wal
storage/database/*.db-shm
storage/database/*.sqlite
storage/database/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Local user uploads, exports, backups, and secrets (keep directory placeholders)
storage/uploads/*
!storage/uploads/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/backups/*
!storage/backups/.gitkeep
storage/secrets/*
!storage/secrets/.gitkeep
!storage/database/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editors
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Build outputs & key files
/build/
/dist/
*.key
*.pem
.claude/settings.local.json

