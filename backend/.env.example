# Personal AI Workspace — Backend Configuration
# Copy this file to .env to customize local settings.
# Never commit .env or API secrets to version control.

APP_NAME="Personal AI Workspace"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

# Local server binding
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# Comma-separated list of allowed local frontend origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local storage directory (relative paths resolve from project root)
STORAGE_DIR="storage"

# SQLite database filename inside <STORAGE_DIR>/database/
DATABASE_FILENAME="personal_ai_workspace.db"

# Optional override for SQLite database URL.
# Leave empty to automatically use <STORAGE_DIR>/database/<DATABASE_FILENAME>
DATABASE_URL=""

# Optional override for Fernet master key (base64-encoded 32-byte key).
# Leave empty to use the local key file stored outside SQLite at <STORAGE_DIR>/secrets/master.key
ENCRYPTION_MASTER_KEY=""

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
